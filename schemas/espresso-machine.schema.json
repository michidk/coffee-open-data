{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://coffee-open-data.dev/schemas/espresso-machine.schema.json",
  "title": "Espresso machine",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "manufacturerId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "boilerType": {
      "type": "string"
    },
    "boilerCount": {
      "type": "integer",
      "minimum": 1
    },
    "pumpType": {
      "type": "string"
    },
    "groupCount": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "id",
    "name",
    "manufacturerId"
  ]
}
