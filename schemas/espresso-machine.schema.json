{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://coffee-open-data.dev/schemas/espresso-machine.schema.json",
  "title": "Espresso machine",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "manufacturerId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "boilerType": {
      "type": "string",
      "enum": [
        "single-boiler",
        "heat-exchanger",
        "dual-boiler",
        "multi-boiler",
        "single-thermoblock",
        "dual-thermoblock",
        "hybrid",
        "manual",
        "other"
      ],
      "x-taxonomy": "espresso-machine-heating-types"
    },
    "boilerCount": {
      "type": "integer",
      "minimum": 1
    },
    "pumpType": {
      "type": "string",
      "enum": [
        "vibration",
        "rotary",
        "gear",
        "peristaltic",
        "manual",
        "other"
      ],
      "x-taxonomy": "pump-types"
    },
    "groupCount": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "propertyKey": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "sourceKind": {
            "type": "string",
            "enum": [
              "manual",
              "manufacturer",
              "specialist",
              "retailer",
              "community",
              "academic",
              "standard"
            ],
            "x-taxonomy": "source-types"
          },
          "rawValue": {},
          "rawUnit": {
            "type": "string",
            "minLength": 1
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "propertyKey",
          "sourceUrl",
          "sourceKind",
          "retrievedAt"
        ]
      }
    },
    "productUrl": {
      "type": "string",
      "format": "uri"
    },
    "manualUrl": {
      "type": "string",
      "format": "uri"
    },
    "waterSourceTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "reservoir",
          "plumbed"
        ],
        "x-taxonomy": "water-source-types"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "equipmentTypeId": {
      "allOf": [
        {
          "type": "string",
          "enum": [
            "espresso-machine",
            "espresso-machine-with-grinder",
            "brewer",
            "grinder",
            "kettle",
            "scale",
            "tamper",
            "wdt",
            "basket",
            "other",
            "pour-over-brewer",
            "immersion-brewer",
            "pressure-brewer",
            "roaster",
            "portafilter",
            "puck-screen",
            "paper-filter",
            "mesh-filter",
            "milk-tool",
            "thermometer",
            "cezve"
          ],
          "x-taxonomy": "equipment-types"
        },
        {
          "enum": [
            "espresso-machine",
            "espresso-machine-with-grinder"
          ]
        }
      ]
    },
    "temperatureControl": {
      "type": "string",
      "enum": [
        "none",
        "fixed",
        "manual",
        "adjustable",
        "programmable"
      ],
      "x-taxonomy": "control-modes"
    },
    "pressureControl": {
      "type": "string",
      "enum": [
        "none",
        "fixed",
        "manual",
        "adjustable",
        "programmable"
      ],
      "x-taxonomy": "control-modes"
    },
    "flowControl": {
      "type": "string",
      "enum": [
        "none",
        "fixed",
        "manual",
        "adjustable",
        "programmable"
      ],
      "x-taxonomy": "control-modes"
    }
  },
  "required": [
    "id",
    "name",
    "manufacturerId",
    "equipmentTypeId"
  ]
}
