{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://coffee-open-data.dev/schemas/grinder.schema.json",
  "title": "Grinder",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "manufacturerId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "burrType": {
      "type": "string",
      "enum": [
        "conical",
        "flat",
        "ghost",
        "roller",
        "blade",
        "other"
      ],
      "x-taxonomy": "grinder-burr-mechanisms"
    },
    "burrSizeMm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "grindSettings": {
      "type": "integer",
      "minimum": 1
    },
    "dosingType": {
      "type": "string",
      "enum": [
        "single-dose",
        "hopper",
        "both"
      ],
      "x-taxonomy": "grinder-bean-feed-types"
    },
    "notes": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "propertyKey": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "sourceKind": {
            "type": "string",
            "enum": [
              "manual",
              "manufacturer",
              "specialist",
              "retailer",
              "community",
              "academic",
              "standard"
            ],
            "x-taxonomy": "source-types"
          },
          "rawValue": {},
          "rawUnit": {
            "type": "string",
            "minLength": 1
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "propertyKey",
          "sourceUrl",
          "sourceKind",
          "retrievedAt"
        ]
      }
    },
    "productUrl": {
      "type": "string",
      "format": "uri"
    },
    "manualUrl": {
      "type": "string",
      "format": "uri"
    },
    "adjustmentType": {
      "type": "string",
      "enum": [
        "fixed",
        "stepped",
        "stepless"
      ],
      "x-taxonomy": "grinder-adjustment-types"
    },
    "burrMaterial": {
      "type": "string",
      "enum": [
        "steel",
        "ceramic",
        "other"
      ],
      "x-taxonomy": "grinder-burr-materials"
    },
    "equipmentTypeId": {
      "allOf": [
        {
          "type": "string",
          "enum": [
            "espresso-machine",
            "espresso-machine-with-grinder",
            "brewer",
            "grinder",
            "kettle",
            "scale",
            "tamper",
            "wdt",
            "basket",
            "other",
            "pour-over-brewer",
            "immersion-brewer",
            "pressure-brewer",
            "roaster",
            "portafilter",
            "puck-screen",
            "paper-filter",
            "mesh-filter",
            "milk-tool",
            "thermometer",
            "cezve"
          ],
          "x-taxonomy": "equipment-types"
        },
        {
          "enum": [
            "grinder"
          ]
        }
      ]
    }
  },
  "required": [
    "id",
    "name",
    "manufacturerId",
    "equipmentTypeId"
  ]
}
