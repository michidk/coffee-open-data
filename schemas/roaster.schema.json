{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://coffee-open-data.dev/schemas/roaster.schema.json",
  "title": "Roaster",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "roastingLocation": {
      "type": "string",
      "minLength": 1
    },
    "foundedYear": {
      "type": "integer",
      "minimum": 1400,
      "maximum": 2100
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "propertyKey": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "sourceKind": {
            "type": "string",
            "enum": [
              "manual",
              "manufacturer",
              "specialist",
              "retailer",
              "community"
            ]
          },
          "rawValue": {},
          "rawUnit": {
            "type": "string",
            "minLength": 1
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "propertyKey",
          "sourceUrl",
          "sourceKind",
          "retrievedAt"
        ]
      }
    },
    "instagramHandle": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "name",
    "roastingLocation"
  ]
}
