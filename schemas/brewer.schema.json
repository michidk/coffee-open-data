{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://coffee-open-data.dev/schemas/brewer.schema.json",
  "title": "Brewer",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "manufacturerId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "brewMethods": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1
    },
    "capacityMl": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "material": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "propertyKey": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "sourceKind": {
            "type": "string",
            "enum": [
              "manual",
              "manufacturer",
              "specialist",
              "retailer",
              "community"
            ]
          },
          "rawValue": {},
          "rawUnit": {
            "type": "string",
            "minLength": 1
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "propertyKey",
          "sourceUrl",
          "sourceKind",
          "retrievedAt"
        ]
      }
    },
    "productUrl": {
      "type": "string",
      "format": "uri"
    },
    "manualUrl": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "id",
    "name",
    "manufacturerId",
    "brewMethods"
  ]
}
