{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://coffee-open-data.dev/schemas/coffee.schema.json",
  "title": "Coffee",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "roasterId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "variety": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "arabica",
          "robusta",
          "liberica",
          "bourbon",
          "typica",
          "caturra",
          "castillo",
          "colombia",
          "geisha",
          "pacamara",
          "maragogipe",
          "sl28",
          "sl34",
          "catimor",
          "sarchimor",
          "pink-bourbon",
          "eugenioides",
          "other"
        ],
        "x-taxonomy": "coffee-varieties"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "processingMethod": {
      "type": "string",
      "enum": [
        "washed",
        "natural",
        "honey",
        "wet-hulled",
        "other"
      ],
      "x-taxonomy": "processing-methods"
    },
    "altitudeM": {
      "type": "number",
      "minimum": 0
    },
    "roastLevel": {
      "type": "string",
      "enum": [
        "light",
        "medium-light",
        "medium",
        "medium-dark",
        "dark",
        "other"
      ],
      "x-taxonomy": "roast-levels"
    },
    "tastingNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "propertyKey": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "sourceKind": {
            "type": "string",
            "enum": [
              "manual",
              "manufacturer",
              "specialist",
              "retailer",
              "community",
              "academic",
              "standard"
            ],
            "x-taxonomy": "source-types"
          },
          "rawValue": {},
          "rawUnit": {
            "type": "string",
            "minLength": 1
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "propertyKey",
          "sourceUrl",
          "sourceKind",
          "retrievedAt"
        ]
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "espresso",
        "filter",
        "omni",
        "other"
      ],
      "x-taxonomy": "coffee-types"
    },
    "isDecaf": {
      "type": "boolean"
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "farm": {
      "type": "string",
      "minLength": 1
    },
    "fermentationMethod": {
      "type": "string",
      "enum": [
        "unspecified",
        "aerobic",
        "anaerobic",
        "carbonic-maceration",
        "lactic",
        "yeast-inoculated",
        "other"
      ],
      "x-taxonomy": "fermentation-methods"
    },
    "flavorNoteIds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "fruity",
          "floral",
          "sweet",
          "nutty-cocoa",
          "spices",
          "sour-fermented",
          "green-vegetative",
          "other",
          "berry",
          "citrus",
          "stone-fruit",
          "tropical-fruit",
          "jasmine",
          "rose",
          "chocolate",
          "caramel",
          "vanilla",
          "cinnamon",
          "clove",
          "winey",
          "tobacco"
        ],
        "x-taxonomy": "flavor-wheel"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "name",
    "origin",
    "variety",
    "processingMethod"
  ]
}
